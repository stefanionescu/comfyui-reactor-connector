{
    "extends": "markdownlint/style/prettier",
    "MD018": true,
    "MD020": true,
    "MD033": false,
    "MD024": {
        "siblings_only": true
    },
    "MD026": {
        "punctuation": ".,;:!。，；：！"
    },
    "MD046": {
        "style": "fenced"
    },
    "MD059": {
        "prohibited_texts": [
            "here",
            "this",
            "this page",
            "read more",
            "more",
            "click here",
            "link",
            "documentation",
            "docs"
        ]
    },
    "MD041": true,
    "MD025": {
        "front_matter_title": ""
    }
}
