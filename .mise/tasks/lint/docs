#!/usr/bin/env bash
#
# Check documentation spelling, Markdown, and local links.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Check documentation spelling, Markdown, and local links."
set -euo pipefail

# main - Check documentation spelling, Markdown, and local links.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  bun --bun node_modules/markdownlint-cli2/markdownlint-cli2-bin.mjs
  typos .
  bun quality/web/links/check.mjs --local
}

main "$@"
