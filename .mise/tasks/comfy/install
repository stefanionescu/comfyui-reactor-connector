#!/usr/bin/env bash
#MISE description="Install the complete package into the supplied ComfyUI directory."
set -euo pipefail

REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
cd "${REPO_ROOT}"

mise run check
mise run security
mise run licenses
exec uv run --no-sync python -m scripts.release.package --install "$@"
