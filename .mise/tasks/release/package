#!/usr/bin/env bash
#
# Build the official node.zip with comfy-cli and inspect it locally.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Build the official node.zip with comfy-cli and inspect it locally."
set -euo pipefail

# main - Build the official node.zip with comfy-cli and inspect it locally.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  mise run check
  comfy node pack "$@"
  unzip -l node.zip
  gitleaks dir node.zip \
    --config quality/config/security/gitleaks/config.toml \
    --max-archive-depth 3 \
    --no-banner \
    --redact \
    --ignore-gitleaks-allow
}

main "$@"
