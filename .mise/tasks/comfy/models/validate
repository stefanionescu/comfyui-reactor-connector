#!/usr/bin/env bash
#
# Check node registrations and guides.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Check node registrations and guides."
set -euo pipefail

# main - Check node registrations and guides.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}/.." || exit 1

  exec uv run --project "${REPO_ROOT}" --no-sync python -m "${REPO_ROOT##*/}.scripts.nodes.metadata" "$@"
}

main "$@"
