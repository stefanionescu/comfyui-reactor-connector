#!/usr/bin/env bash
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Check repository sources and staged secrets without changing the index."
set -euo pipefail

REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
cd "${REPO_ROOT}" || exit 1

# shellcheck source=../../../quality/repository/hooks/steps.sh
source "${REPO_ROOT}/quality/repository/hooks/steps.sh"

if [[ ${SKIP_HOOKS:-0} == "1" ]]; then
  printf '%s\n' '[hook] skipped pre-commit checks (SKIP_HOOKS=1)'
  exit 0
fi

uv run --no-sync python -m quality.repository.hooks.staged
run_step "staged secrets" "" bash quality/security/gitleaks/run.sh staged
run_step "repository checks" SKIP_LINT mise run check
