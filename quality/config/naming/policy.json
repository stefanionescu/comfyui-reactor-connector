{
    "version": 1,
    "global_policy": {
        "are_digits_banned": true,
        "banned_term_exemptions": ["__all__", "__init__", "__main__"]
    },
    "languages": {
        "python": {
            "max_characters": 35,
            "max_words": 4,
            "files": ["snake"],
            "directories": ["snake"],
            "modules": ["snake"],
            "packages": ["snake"],
            "classes": ["pascal"],
            "exceptions": ["pascal"],
            "functions": ["snake"],
            "methods": ["snake"],
            "parameters": ["snake"],
            "variables": ["snake", "upper-snake"],
            "constants": ["upper-snake"],
            "attributes": ["snake", "upper-snake"],
            "type_aliases": ["pascal"]
        },
        "shell": {
            "max_characters": 35,
            "max_words": 4,
            "files": ["kebab", "snake"],
            "directories": ["kebab", "snake"],
            "functions": ["snake"],
            "variables": ["snake", "upper-snake"]
        }
    },
    "name_rules": [
        {
            "path_regexes": ["^(\\.githooks/|\\.mise/tasks/).*"],
            "languages": ["shell"],
            "categories": ["directories"],
            "names": [".githooks", ".mise"],
            "is_excluded": true
        },
        {
            "path_regexes": [".*"],
            "languages": ["python"],
            "categories": ["methods"],
            "names": [
                "visit_ClassDef",
                "visit_FunctionDef",
                "visit_AsyncFunctionDef",
                "visit_Import",
                "visit_ImportFrom",
                "visit_Assign",
                "visit_AnnAssign",
                "visit_If",
                "visit_Name",
                "visit_Attribute"
            ],
            "is_excluded": true
        },
        {
            "path_regexes": ["^quality/security/codeql/python/scan\\.sh$"],
            "languages": ["shell"],
            "categories": ["variables"],
            "names": [
                "CODEQL_EXTRACTOR_PYTHON_ANALYSIS_VERSION",
                "CODEQL_EXTRACTOR_PYTHON_OPTION_PYTHON_EXECUTABLE_NAME"
            ],
            "is_excluded": true
        },
        {
            "path_regexes": [".*"],
            "categories": [
                "variables",
                "constants",
                "classes",
                "exceptions",
                "type_aliases",
                "attributes",
                "parameters"
            ],
            "names": ["_"],
            "is_excluded": true
        },
        {
            "path_regexes": [".*"],
            "categories": [
                "variables",
                "constants",
                "classes",
                "exceptions",
                "type_aliases",
                "attributes",
                "parameters"
            ],
            "structural_prefix_regexes": ["^_+"]
        },
        {
            "path_regexes": [".*"],
            "names": ["i", "j", "k", "x", "y"],
            "is_excluded": true
        },
        {
            "path_regexes": [".*"],
            "languages": ["python"],
            "categories": ["files"],
            "names": ["__init__", "__main__"],
            "is_excluded": true
        },
        {
            "path_regexes": ["^src/settings/settings\\.py$"],
            "languages": ["python"],
            "categories": ["variables"],
            "names": ["catalog_interval_hours", "catalog_auto_check"],
            "allowed_banned_terms": ["catalog"],
            "reason": "These names are the persisted settings fields exposed by the local configuration API."
        },
        {
            "path_regexes": ["^src/extension\\.py$"],
            "languages": ["python"],
            "categories": ["methods"],
            "names": ["on_load"],
            "allowed_banned_terms": ["load"],
            "reason": "ComfyUI calls this lifecycle method by its exact name."
        },
        {
            "path_regexes": ["(?:^src/media/capture\\.py$|^src/live/preview\\.py$)"],
            "languages": ["python"],
            "categories": ["parameters"],
            "names": ["user_data"],
            "allowed_banned_terms": ["data"],
            "reason": "The Reactor frame callback uses this parameter for optional frame metadata."
        },
        {
            "path_regexes": ["(?:^src/execution/visko/request\\.py$|^src/nodes/visko/stable\\.py$)"],
            "languages": ["python"],
            "categories": ["variables", "parameters"],
            "names": ["resolution"],
            "allowed_banned_terms": ["resolution"],
            "reason": "The Visko command schema and saved node input use this field name."
        },
        {
            "path_regexes": ["(?:^src/execution/x2(?:/|$)|^src/nodes/x2/|^scripts/workflows/models/x2\\.py$)"],
            "languages": ["python"],
            "categories": ["files", "directories"],
            "names": ["x2"],
            "are_digits_allowed": true
        },
        {
            "path_regexes": ["^src/comfy/interaction\\.py$"],
            "languages": ["python"],
            "categories": ["methods"],
            "names": ["send_sync"],
            "allowed_banned_terms": ["sync_", "sync-", "-sync", "_sync"],
            "reason": "ComfyUI exposes this method on PromptServer."
        },
        {
            "path_regexes": ["^quality/repository/naming/extractors/python\\.py$"],
            "languages": ["python"],
            "categories": ["methods"],
            "names": ["generic_visit"],
            "allowed_banned_terms": ["generic"],
            "reason": "Python calls this method while traversing an AST visitor."
        }
    ],
    "excluded_paths": [
        "/.artifacts/",
        "/.git/",
        "/.cache/",
        "/.ruff_cache/",
        "/.venv/",
        "/__pycache__/",
        "/build/",
        "/dist/",
        "/node_modules/"
    ],
    "excluded_basenames": ["uv.lock", "bun.lock"]
}
