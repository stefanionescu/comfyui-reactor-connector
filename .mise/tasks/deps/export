#!/usr/bin/env bash
#
# Generate ComfyUI runtime requirements.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Generate ComfyUI runtime requirements."
set -euo pipefail

# main - Generate ComfyUI runtime requirements.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  exec uv run --directory "${REPO_ROOT}/.." --project "${REPO_ROOT}" --no-sync python -m "${REPO_ROOT##*/}.scripts.dependencies" "$@"
}

main "$@"
