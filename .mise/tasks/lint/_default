#!/usr/bin/env bash
#
# Run the source and documentation checks.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Run the source and documentation checks."
set -euo pipefail

# main - Run the source and documentation checks.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  mise run lint:policy
  mise run lint:python
  mise run lint:frontend
  mise run lint:shell
  mise run lint:quality
}

main "$@"
