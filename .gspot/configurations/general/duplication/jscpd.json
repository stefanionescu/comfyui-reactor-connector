{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignorePattern": [
        "import\\s[^;]*?from\\s*['\"][^'\"]+['\"]\\s*;"
    ],
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        "**/build/**",
        "**/.venv/**",
        "**/node_modules/**",
        "**/__pycache__/**",
        "**/*.py[cod]",
        "**/.ruff_cache/**",
        "dist/**",
        "**/.artifacts/**",
        "**/.import_linter_cache/**",
        "**/.env",
        "**/.env.*",
        "**/.mise.local.toml",
        "**/*.log",
        "**/.DS_Store",
        ".gspot/**",
        ".stylelintrc.json",
        "eslint.config.mjs",
        ".markdownlint.jsonc",
        "ruff.toml",
        "pyrightconfig.json",
        ".editorconfig",
        "prettier.config.mjs",
        ".prettierignore",
        "web/extension.js",
        "web/extension.css",
        "example_workflows/*.json",
        "**/requirements.txt",
        "example_workflows/assets/*.png",
        "**/bower_components/**",
        "**/venv/**",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/bun.lock",
        "**/uv.lock",
        "**/.env*",
        "src/nodes/**"
    ]
}
