{
    "matching": {
        "caseInsensitive": true
    },
    "global": {
        "bannedTermExemptions": [
            "CustomEvent",
            "HTMLDialogElement",
            "HTMLElement",
            "URL",
            "URLSearchParams",
            "console",
            "document",
            "localStorage",
            "navigator",
            "sessionStorage",
            "window"
        ],
        "reservedTerms": [
            {
                "term": "config",
                "allowedKinds": [
                    "javascript directory",
                    "javascript file stem",
                    "javascript variable",
                    "javascript property"
                ]
            }
        ]
    },
    "local": {
        "bannedTerms": [
            {
                "scopes": ["frontend", "quality"],
                "terms": ["tmp", "temp"]
            }
        ]
    },
    "languages": {
        "javascript": {
            "categories": {
                "classes": ["pascal"],
                "directories": ["kebab"],
                "files": ["kebab"],
                "functions": ["camel"],
                "parameters": ["camel"],
                "properties": ["camel", "upper-snake"],
                "variables": ["camel", "upper-snake"]
            }
        }
    },
    "nameRules": [
        {
            "pathRegexes": ["^quality/config/security/"],
            "categories": ["files"],
            "caseNames": ["kebab"]
        },
        {
            "pathRegexes": ["^web/live/api\\.ts$"],
            "categories": ["properties"],
            "names": ["preview_sequence"],
            "caseNames": ["snake"],
            "reason": "These fields are serialized by the local ComfyUI API and must keep their wire names."
        },
        {
            "pathRegexes": ["^web/live/commands\\.ts$"],
            "categories": ["properties"],
            "names": ["prompt_limit", "audio_prompt"],
            "caseNames": ["snake"],
            "reason": "These fields are serialized by the local ComfyUI API and must keep their wire names."
        },
        {
            "pathRegexes": ["^web/settings/api\\.ts$"],
            "categories": ["properties"],
            "names": ["catalog_auto_check", "catalog_interval_hours"],
            "caseNames": ["snake"],
            "reason": "These fields are serialized by the local ComfyUI API and must keep their wire names."
        },
        {
            "pathRegexes": ["^quality/web/madge\\.config\\.cjs$"],
            "categories": ["files"],
            "names": ["madge.config"],
            "structuralPrefixRegexes": ["\\.config$"],
            "reason": "The graph tool configuration uses the documented .config.cjs suffix."
        },
        {
            "pathRegexes": ["^web/host\\.d\\.ts$"],
            "categories": ["functions"],
            "names": ["getCustomNodesI18n"],
            "exclude": true,
            "reason": "ComfyUI exposes its translation loader with this exact method name."
        },
        {
            "pathRegexes": ["^web/host\\.d\\.ts$"],
            "categories": ["properties", "functions"],
            "names": ["extensionManager", "loadedGraphNode", "fetchApi"],
            "exclude": true,
            "reason": "ComfyUI supplies these exact API member names."
        },
        {
            "pathRegexes": ["^web/nodes/contracts\\.ts$"],
            "categories": ["properties"],
            "names": ["advanced"],
            "exclude": true,
            "reason": "ComfyUI widgets use this exact property to control advanced inputs."
        },
        {
            "pathRegexes": ["^web/settings/api\\.ts$"],
            "categories": ["properties"],
            "names": ["catalog_auto_check", "catalog_interval_hours"],
            "exclude": true,
            "reason": "These persisted setting keys are sent unchanged to the server."
        }
    ],
    "excludedPaths": [
        "/.git/",
        "/.artifacts/",
        "/dist/",
        "/node_modules/",
        "/rules/",
        "/quality/shared/eslint/plugin/"
    ],
    "excludedBasenames": [
        ".commitlintrc.json",
        ".license-checker.json",
        ".markdownlint-cli2.jsonc",
        "README.md",
        "AGENTS.md",
        "bun.lock",
        "package.json"
    ]
}
