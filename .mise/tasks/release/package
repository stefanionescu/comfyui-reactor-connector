#!/usr/bin/env bash
#
# Check and build the complete ComfyUI package.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Check and build the complete ComfyUI package."
set -euo pipefail

# main - Check and build the complete ComfyUI package.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  mise run check
  exec uv run --directory "${REPO_ROOT}/.." --project "${REPO_ROOT}" --no-sync python -m "${REPO_ROOT##*/}.scripts.release" "$@"
}

main "$@"
