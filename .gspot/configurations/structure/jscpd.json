{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignorePattern": [
        "import\\s[^;]*?from\\s*['\"][^'\"]+['\"]\\s*;",
        "(?:^|\\n)[\\t ]*(?:from[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*[\\w.]+[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*)?import[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*(?:\\([^;)]*\\)|(?:\\\\\\r?\\n|[^;\\r\\n])*)"
    ],
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        "**/build/**",
        ".gspot/**",
        ".gspot-copies/**",
        ".editorconfig",
        ".github/workflows/gspot.yml",
        ".markdownlint.jsonc",
        ".prettierignore",
        ".stylelintrc.yml",
        "eslint.config.mjs",
        "prettier.config.mjs",
        "pyrightconfig.json",
        "ruff.toml",
        "web/extension.js",
        "web/extension.css",
        "example_workflows/*.json",
        "**/requirements.txt",
        "example_workflows/assets/*.png",
        "**/node_modules/**",
        "**/bower_components/**",
        "**/.venv/**",
        "**/venv/**",
        "**/__pycache__/**",
        "**/.pytest_cache/**",
        "**/.ruff_cache/**",
        "**/.mypy_cache/**",
        "**/coverage/**",
        "**/.env",
        "**/.env.*",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/bun.lock",
        "**/uv.lock",
        "**/*.py[cod]",
        "dist/**",
        "**/.artifacts/**",
        "**/.import_linter_cache/**",
        "**/.mise.local.toml",
        "**/*.log",
        "**/.DS_Store",
        "src/nodes/**"
    ]
}
