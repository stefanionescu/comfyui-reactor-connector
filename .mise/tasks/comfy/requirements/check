#!/usr/bin/env bash
#
# Check that requirements.txt matches pyproject.toml.
# Runtime: Bash 3.2+ on macOS or Linux.
#MISE description="Check that requirements.txt matches pyproject.toml."
set -euo pipefail

# main - Check that requirements.txt matches pyproject.toml.
main() {
    REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
    cd "${REPO_ROOT}/.." || exit 1

    exec uv run --project "${REPO_ROOT}" --no-sync python -m "${REPO_ROOT##*/}.scripts.dependencies" --check "$@"
}

main "$@"
